{
  "name": "@kkhay/react",
  "version": "1.0.1",
  "description": "Official drop-in React & Next.js crypto checkout modal and UI SDK for K Khay Payment Gateway (USDT, USDC, BNB, ETH).",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "kkhay",
    "crypto",
    "checkout",
    "payment-gateway",
    "react",
    "nextjs",
    "react-component",
    "modal",
    "usdt",
    "usdc",
    "bnb",
    "ethereum",
    "web3"
  ],
  "author": "K Khay <support@kkhay.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boboaungdev/kkhay-react.git"
  },
  "bugs": {
    "url": "https://github.com/boboaungdev/kkhay-react/issues"
  },
  "homepage": "https://kkhay.com",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "qrcode.react": "^4.2.0"
  }
}
